{
  "evidence_type": "controlled syscall wrapper tests; injected errors are simulated",
  "source_snapshot": "#include <fcntl.h>   // open、O_RDONLY\n#include <unistd.h>  // close\n#include <cstdio>    // printf、perror\n#include <cerrno>\n\nbool write_all(int out_fd, const char* data, size_t total) {\n    size_t done = 0;\n\n    while (done < total) {\n        ssize_t written = write(out_fd, data + done, total - done);\n\n        if (written < 0) {\n            if (errno == EINTR) {\n                continue;\n            }\n            std::perror(\"write\");\n            return false;\n        }\n\n        if (written == 0) {\n            std::fprintf(stderr, \"write: no progress\\n\");\n            return false;\n        }\n\n        done += written;\n    }\n\n    return true;\n}\nint main(int argc, char* argv[]) {\n    if (argc != 3) {\n        std::fprintf(stderr, \"usage: %s SOURCE DEST\\n\", argv[0]);\n        return 2;\n    }\n\n    int in_fd = open(argv[1], O_RDONLY);\n    if (in_fd < 0) {\n        std::perror(\"open source\");\n        return 1;\n    }\n\n    int out_fd = open(argv[2], O_WRONLY | O_CREAT | O_EXCL, 0600);\n    if (out_fd < 0) {\n        std::perror(\"open destination\");\n        close(in_fd);\n        return 1;\n    }\n\n    char buf[4];\n    int result = 0;\n\n    while (true) {\n        ssize_t n = read(in_fd, buf, sizeof(buf));\n\n        if (n < 0) {\n            if (errno == EINTR) {\n                continue;\n            }\n            std::perror(\"read\");\n            result = 1;\n            break;\n        }\n\n        if (n == 0) {\n            break;\n        }\n\n        if (!write_all(out_fd, buf, static_cast<size_t>(n))) {\n            result = 1;\n            break;\n        }\n    }\n\n    if (close(in_fd) < 0) {\n        std::perror(\"close source\");\n        result = 1;\n    }\n\n    if (close(out_fd) < 0) {\n        std::perror(\"close destination\");\n        result = 1;\n    }\n\n    return result;\n}",
